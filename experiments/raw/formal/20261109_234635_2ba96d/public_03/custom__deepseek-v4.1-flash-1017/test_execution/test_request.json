{
  "task": {
    "id": "public_03",
    "title": "Alarm Handling",
    "difficulty": "easy",
    "source_type": "provided",
    "source_reference": "大作业题库json/大作业题库.json, easy[2]",
    "requirements": "Implement an alarm management function block with hysteresis. When Value is greater than hiLevel, set hiAlarm. Clear hiAlarm only when Value is less than hiLevel - hystWindow. When Value is less than loLevel, set loAlarm. Clear loAlarm only when Value is greater than loLevel + hystWindow. If loLevel is greater than or equal to hiLevel, set error to TRUE and status to 16#8001, then skip normal alarm processing for that invocation. If hystWindow is greater than or equal to hiLevel - loLevel, set error to TRUE and status to 16#8002, then skip normal alarm processing for that invocation. When the configuration is valid, set error to FALSE and status to 16#0000.",
    "pou_name": "FB_AlarmHandling",
    "pou_type": "FUNCTION_BLOCK",
    "interface": [
      {
        "direction": "input",
        "name": "Value",
        "data_type": "REAL",
        "description": "Input value"
      },
      {
        "direction": "input",
        "name": "hiLevel",
        "data_type": "REAL",
        "description": "High alarm threshold"
      },
      {
        "direction": "input",
        "name": "loLevel",
        "data_type": "REAL",
        "description": "Low alarm threshold"
      },
      {
        "direction": "input",
        "name": "hystWindow",
        "data_type": "REAL",
        "description": "Hysteresis window"
      },
      {
        "direction": "output",
        "name": "hiAlarm",
        "data_type": "BOOL",
        "description": "High alarm state"
      },
      {
        "direction": "output",
        "name": "loAlarm",
        "data_type": "BOOL",
        "description": "Low alarm state"
      },
      {
        "direction": "output",
        "name": "error",
        "data_type": "BOOL",
        "description": "TRUE when the configuration is invalid"
      },
      {
        "direction": "output",
        "name": "status",
        "data_type": "WORD",
        "description": "16#0000 for valid configuration, 16#8001 for loLevel >= hiLevel, or 16#8002 for an excessive hysteresis window"
      }
    ],
    "custom_types": [],
