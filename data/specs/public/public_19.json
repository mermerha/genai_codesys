{
  "task_id": "public_19",
  "state_semantics": "每个测试步骤设置一次 PLC 扫描的输入，输出在该次扫描执行后观察；LTL 中 X 表示该扫描后的状态。定时命题依据输入连续保持时间和测试步骤的 advance_ms 判定。",
  "propositions": {
    "permit": "EmergencyStop 为 TRUE",
    "manual": "ManualMode",
    "single_step": "SingleStepMode",
    "single_cycle": "SingleCycleMode",
    "continuous": "ContinuousMode",
    "start_rise": "Start 上升沿",
    "all_off": "六个动作输出均关闭",
    "vertical_conflict": "MoveDown 与 MoveUp 同时为 TRUE",
    "horizontal_conflict": "MoveLeft 与 MoveRight 同时为 TRUE",
    "grip_conflict": "ActivateGrip 与 ActivateRelease 同时为 TRUE",
    "action_done": "当前动作限位到达",
    "waiting": "单步模式等待下一次启动",
    "cycle_complete": "回到左上位置且本轮完成"
  },
  "assumptions": [
    "四个模式输入互斥；初始位置为左上；夹取和释放反馈最终到达。"
  ],
  "properties": [
    {
