{
  "task_id": "public_16",
  "state_semantics": "每个测试步骤设置一次 PLC 扫描的输入，输出在该次扫描执行后观察；LTL 中 X 表示该扫描后的状态。定时命题依据输入连续保持时间和测试步骤的 advance_ms 判定。",
  "propositions": {
    "started": "sensor1 与 station1Start",
    "target_right": "下一目标站在当前位置右侧",
    "target_left": "下一目标站在当前位置左侧",
    "at_target": "目标站传感器有效",
    "station_complete": "当前加工站完成",
    "left": "conveyorLeft",
    "right": "conveyorRight",
    "sequence_done": "已到最终站 5"
  },
  "assumptions": [
    "processLength 为 1..8；最后一项为 5，其余项为 2..4；对应目标传感器最终会到达。"
  ],
  "properties": [
    {
      "id": "public_16_p01",
      "type": "safety",
      "description": "输送带左右方向永不同时输出",
      "ltl": "G(!(left && right))",
      "tool_expression": null
    },
    {
      "id": "public_16_p02",
      "type": "response",
      "description": "目标在右侧时向右输送",
      "ltl": "G((started || station_complete) && target_right -> X(right && !left))",
      "tool_expression": null
    },
    {
      "id": "public_16_p03",
      "type": "response",
      "description": "目标在左侧时向左输送",
      "ltl": "G((started || station_complete) && target_left -> X(left && !right))",
      "tool_expression": null
    },
    {
      "id": "public_16_p04",
      "type": "transition",
      "description": "到达目标站后停止输送",
      "ltl": "G(at_target -> X(!left && !right))",
      "tool_expression": null
    },
    {
      "id": "public_16_p05",
      "type": "completion",
      "description": "到达最终站后保持停止",
      "ltl": "G(sequence_done -> X(!left && !right))",
      "tool_expression": null
    }
  ],
  "review": {
    "status": "frozen",
    "reviewer": "Codex",
    "notes": [
      "已按工具无关 LTL 冻结；tool_expression 在确定验证工具后填写。"
    ]
  }
}
