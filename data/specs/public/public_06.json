      "tool_expression": null
    },
    {
      "id": "public_06_p03",
      "type": "safety",
      "description": "延时未完成前不得启动",
      "ltl": "G((permit && demand && !delay_done) -> X(!run))",
      "tool_expression": null
    },
    {
      "id": "public_06_p04",
      "type": "accounting",
      "description": "每次实际启动仅增加一次计数",
      "ltl": "G(run_rise -> X(count_incremented))",
      "tool_expression": null
    }
  ],
