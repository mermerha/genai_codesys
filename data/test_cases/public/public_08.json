    {
      "id": "public_08_tc01",
      "task_id": "public_08",
      "name": "线性单极性与双极性换算",
      "initial_state": {},
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "count": 2,
            "analogValues": [
              13824,
              0
            ],
            "channels": [
              {
                "enable": true,
                "hiLIM": 100,
                "loLIM": 0,
                "bipolar": false,
                "measuringMode": 0,
                "retVal": "16#0000",
                "outputValue": 0
              },
              {
                "enable": true,
                "hiLIM": 10,
                "loLIM": -10,
                "bipolar": true,
                "measuringMode": 0,
                "retVal": "16#0000",
                "outputValue": 0
              }
            ]
          },
          "expected_outputs": {
            "channels": [
              {
                "enable": true,
                "hiLIM": 100,
                "loLIM": 0,
                "bipolar": false,
                "measuringMode": 0,
                "retVal": "16#0000",
                "outputValue": 50
              },
              {
                "enable": true,
                "hiLIM": 10,
                "loLIM": -10,
                "bipolar": true,
                "measuringMode": 0,
                "retVal": "16#0000",
                "outputValue": 0
              }
            ]
          },
          "check": "分别得到 50 和 0"
        }
      ],
      "coverage": [
        "linear_scaling",
        "unipolar",
        "bipolar"
      ],
      "review": {
        "status": "frozen",
        "reviewer": "Codex",
        "notes": []
      }
    },
