{
  "task_id": "public_13",
  "tests": [
    {
      "id": "public_13_tc01",
      "task_id": "public_13",
      "name": "有人时延时启动风机",
      "initial_state": {
        "SUPPLY_FAN_RUN": false
      },
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "OCCUPANCY_DETECTED": true,
            "ENERGY_SAVING_MODE": false,
            "HVAC_MODE_SELECTOR": 0
          },
          "expected_outputs": {
            "SUPPLY_FAN_RUN": false,
            "TEMP_SETPOINT_ADJUST": 0
          },
          "check": "开始 30 秒延时"
        },
        {
          "cycle": 1,
          "advance_ms": 25000,
          "inputs": {
            "OCCUPANCY_DETECTED": true,
            "ENERGY_SAVING_MODE": false,
            "HVAC_MODE_SELECTOR": 0
          },
          "expected_outputs": {
            "SUPPLY_FAN_RUN": false,
            "TEMP_SETPOINT_ADJUST": 0
          },
          "check": "未满 30 秒"
        },
        {
          "cycle": 2,
          "advance_ms": 5000,
          "inputs": {
            "OCCUPANCY_DETECTED": true,
            "ENERGY_SAVING_MODE": false,
            "HVAC_MODE_SELECTOR": 0
          },
          "expected_outputs": {
            "SUPPLY_FAN_RUN": true,
            "TEMP_SETPOINT_ADJUST": 0
          },
          "check": "满 30 秒启动"
        }
      ],
      "coverage": [
        "fan_delay",
        "auto_mode"
      ],
      "review": {
        "status": "frozen",
        "reviewer": "Codex",
        "notes": []
      }
    },
