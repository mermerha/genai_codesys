          "expected_outputs": {
            "SUPPLY_FAN_RUN": false,
            "TEMP_SETPOINT_ADJUST": 1
          },
          "check": "舒适模式 +1"
        },
        {
          "cycle": 3,
          "inputs": {
            "OCCUPANCY_DETECTED": false,
            "ENERGY_SAVING_MODE": false,
            "HVAC_MODE_SELECTOR": 2
          },
          "expected_outputs": {
            "SUPPLY_FAN_RUN": false,
            "TEMP_SETPOINT_ADJUST": 4
          },
          "check": "经济模式 +4"
        }
      ],
