    {
      "id": "public_13_tc03",
      "task_id": "public_13",
      "name": "夜间模式停止并重置启动延时",
      "initial_state": {
        "SUPPLY_FAN_RUN": false
      },
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "OCCUPANCY_DETECTED": true,
            "ENERGY_SAVING_MODE": false,
            "HVAC_MODE_SELECTOR": 0
          },
          "expected_outputs": {
            "SUPPLY_FAN_RUN": false,
            "TEMP_SETPOINT_ADJUST": 0
          },
          "check": "通过公开输入开始启动延时"
        },
        {
          "cycle": 1,
          "advance_ms": 30000,
          "inputs": {
            "OCCUPANCY_DETECTED": true,
            "ENERGY_SAVING_MODE": false,
            "HVAC_MODE_SELECTOR": 0
          },
          "expected_outputs": {
            "SUPPLY_FAN_RUN": true,
            "TEMP_SETPOINT_ADJUST": 0
          },
          "check": "建立风机运行状态"
        },
        {
          "cycle": 2,
          "inputs": {
            "OCCUPANCY_DETECTED": true,
            "ENERGY_SAVING_MODE": false,
            "HVAC_MODE_SELECTOR": 3
          },
          "expected_outputs": {
            "SUPPLY_FAN_RUN": false,
            "TEMP_SETPOINT_ADJUST": 4
          },
          "check": "夜间立即停止"
        },
        {
          "cycle": 3,
          "inputs": {
            "OCCUPANCY_DETECTED": true,
            "ENERGY_SAVING_MODE": false,
            "HVAC_MODE_SELECTOR": 0
          },
          "expected_outputs": {
            "SUPPLY_FAN_RUN": false,
            "TEMP_SETPOINT_ADJUST": 0
          },
          "check": "返回自动后重新延时"
        },
        {
          "cycle": 4,
          "advance_ms": 30000,
          "inputs": {
            "OCCUPANCY_DETECTED": true,
            "ENERGY_SAVING_MODE": false,
            "HVAC_MODE_SELECTOR": 0
          },
          "expected_outputs": {
            "SUPPLY_FAN_RUN": true,
            "TEMP_SETPOINT_ADJUST": 0
          },
          "check": "重新满 30 秒后启动"
        }
      ],
      "coverage": [
        "night_mode",
        "delay_reset"
      ],
      "review": {
        "status": "frozen",
        "reviewer": "Codex",
        "notes": []
      }
    }
