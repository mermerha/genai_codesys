        {
          "cycle": 0,
          "inputs": {
            "processLength": 2,
            "sensor1": true,
            "sensor2": false,
            "sensor3": false,
            "sensor4": false,
            "sensor5": false,
            "station1Start": true,
            "station2Complete": false,
            "station3Complete": false,
            "station4Complete": false,
            "processSequence": [
              2,
              5,
              0,
              0,
              0,
              0,
              0,
              0
            ]
          },
          "expected_outputs": {
            "conveyorLeft": false,
            "conveyorRight": true
          },
          "check": "从 1 前往 2"
        },
        {
          "cycle": 1,
          "inputs": {
            "processLength": 2,
            "sensor1": false,
            "sensor2": true,
            "sensor3": false,
            "sensor4": false,
            "sensor5": false,
            "station1Start": false,
            "station2Complete": false,
            "station3Complete": false,
            "station4Complete": false,
            "processSequence": [
              2,
              5,
              0,
              0,
              0,
              0,
              0,
              0
            ]
          },
          "expected_outputs": {
            "conveyorLeft": false,
            "conveyorRight": false
          },
          "check": "到达 2 停止"
        },
        {
          "cycle": 2,
          "inputs": {
            "processLength": 2,
            "sensor1": false,
            "sensor2": true,
            "sensor3": false,
            "sensor4": false,
            "sensor5": false,
            "station1Start": false,
            "station2Complete": true,
            "station3Complete": false,
            "station4Complete": false,
            "processSequence": [
              2,
              5,
              0,
              0,
              0,
              0,
              0,
              0
            ]
          },
          "expected_outputs": {
            "conveyorLeft": false,
            "conveyorRight": true
          },
          "check": "2 完成后前往 5"
        },
        {
          "cycle": 3,
          "inputs": {
            "processLength": 2,
            "sensor1": false,
            "sensor2": false,
            "sensor3": false,
            "sensor4": false,
            "sensor5": true,
            "station1Start": false,
            "station2Complete": false,
            "station3Complete": false,
            "station4Complete": false,
            "processSequence": [
              2,
              5,
              0,
              0,
              0,
              0,
              0,
              0
            ]
          },
          "expected_outputs": {
            "conveyorLeft": false,
            "conveyorRight": false
          },
          "check": "到达 5 结束"
