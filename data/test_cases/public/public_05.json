      "task_id": "public_05",
      "name": "上电五秒抑制",
      "initial_state": {
        "Operator_Alert": false,
        "Weld_Soft_Start_Active": true
      },
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "Gap_Exceeded": true,
            "Weld_E_Stop_NC": true,
            "DebounceTime": "T#1s"
          },
          "expected_outputs": {
            "Operator_Alert": false,
            "Weld_Soft_Start_Active": true
          },
          "check": "上电仍抑制"
        },
        {
          "cycle": 1,
          "advance_ms": 4000,
          "inputs": {
            "Gap_Exceeded": true,
            "Weld_E_Stop_NC": true,
            "DebounceTime": "T#1s"
          },
          "expected_outputs": {
            "Operator_Alert": false,
            "Weld_Soft_Start_Active": true
          },
          "check": "未满 5 秒"
        },
        {
          "cycle": 2,
          "advance_ms": 1000,
          "inputs": {
            "Gap_Exceeded": false,
            "Weld_E_Stop_NC": true,
            "DebounceTime": "T#1s"
          },
          "expected_outputs": {
            "Operator_Alert": false,
            "Weld_Soft_Start_Active": false
          },
          "check": "5 秒后结束抑制"
        }
      ],
      "coverage": [
        "initialization_delay"
      ],
      "review": {
        "status": "frozen",
        "reviewer": "Codex",
        "notes": []
      }
    },
