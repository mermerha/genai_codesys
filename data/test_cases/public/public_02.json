      "task_id": "public_02",
      "name": "混合上升与下降位",
      "initial_state": {},
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "value": 0
          },
          "expected_outputs": {
            "hasChanged": false,
            "hasRisingEdges": false,
            "risingBits": 0,
            "noOfRisingBits": 0,
            "hasFallingEdges": false,
            "fallingBits": 0,
            "noOfFallingBits": 0
          },
          "check": "零值初始化"
        },
        {
          "cycle": 1,
          "inputs": {
            "value": 5
          },
          "expected_outputs": {
            "hasChanged": true,
            "hasRisingEdges": true,
            "risingBits": 5,
            "noOfRisingBits": 2,
            "hasFallingEdges": false,
            "fallingBits": 0,
            "noOfFallingBits": 0
          },
          "check": "位 0 和 2 上升"
        },
        {
          "cycle": 2,
          "inputs": {
            "value": 2
          },
          "expected_outputs": {
            "hasChanged": true,
            "hasRisingEdges": true,
            "risingBits": 2,
            "noOfRisingBits": 1,
            "hasFallingEdges": true,
            "fallingBits": 5,
            "noOfFallingBits": 2
          },
          "check": "位 1 上升，位 0 和 2 下降"
        }
      ],
      "coverage": [
        "rising_edges",
        "falling_edges",
        "bit_count"
      ],
      "review": {
        "status": "frozen",
        "reviewer": "Codex",
        "notes": []
      }
    },
