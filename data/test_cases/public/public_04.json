    {
      "id": "public_04_tc01",
      "task_id": "public_04",
      "name": "粘度防抖后启动",
      "initial_state": {
        "VFD_RUN": false,
        "PUMP_RUNTIME_ACC": "LTIME#0s",
        "PUMP_MAINT_DUE": false
      },
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "VISCOSITY_OK": true,
            "PASTE_E_STOP_NC": true,
            "DebounceTime": "T#2s",
            "CycleTime": "T#1s"
          },
          "expected_outputs": {
            "VFD_RUN": false
          },
          "check": "开始防抖"
        },
        {
          "cycle": 1,
          "advance_ms": 1000,
          "inputs": {
            "VISCOSITY_OK": true,
            "PASTE_E_STOP_NC": true,
            "DebounceTime": "T#2s",
            "CycleTime": "T#1s"
          },
          "expected_outputs": {
            "VFD_RUN": false
          },
          "check": "1 秒未到"
        },
        {
          "cycle": 2,
          "advance_ms": 1000,
          "inputs": {
            "VISCOSITY_OK": true,
            "PASTE_E_STOP_NC": true,
            "DebounceTime": "T#2s",
            "CycleTime": "T#1s"
          },
          "expected_outputs": {
            "VFD_RUN": true
          },
          "check": "2 秒后运行"
        }
      ],
      "coverage": [
        "debounce",
        "normal_start"
      ],
      "review": {
        "status": "frozen",
        "reviewer": "Codex",
        "notes": []
      }
    },
