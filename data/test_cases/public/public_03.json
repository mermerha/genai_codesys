{
  "task_id": "public_03",
  "tests": [
    {
      "id": "public_03_tc01",
      "task_id": "public_03",
      "name": "高报警滞回",
      "initial_state": {
        "hiAlarm": false,
        "loAlarm": false
      },
      "steps": [
        {
          "cycle": 0,
          "inputs": {
            "Value": 21,
            "hiLevel": 20,
            "loLevel": 10,
            "hystWindow": 2
          },
          "expected_outputs": {
            "hiAlarm": true,
            "error": false,
            "status": "16#0000"
          },
          "check": "超过高限触发"
        },
        {
          "cycle": 1,
          "inputs": {
            "Value": 19,
            "hiLevel": 20,
            "loLevel": 10,
            "hystWindow": 2
          },
          "expected_outputs": {
            "hiAlarm": true
          },
          "check": "未低于清除阈值时保持"
        },
        {
          "cycle": 2,
          "inputs": {
            "Value": 17.9,
            "hiLevel": 20,
            "loLevel": 10,
            "hystWindow": 2
          },
          "expected_outputs": {
            "hiAlarm": false
          },
          "check": "低于 18 后清除"
        }
      ],
      "coverage": [
        "high_alarm",
        "hysteresis"
      ],
      "review": {
        "status": "frozen",
        "reviewer": "Codex",
        "notes": []
      }
    },
    {
      "id": "public_03_tc02",
      "task_id": "public_03",
