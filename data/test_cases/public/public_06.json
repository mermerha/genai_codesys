            "DO_LOW": true,
            "AERATION_E_STOP_NC": true
          },
          "expected_outputs": {
            "BLOWER_RUN": false
          },
          "check": "开始延时"
        },
        {
          "cycle": 1,
          "advance_ms": 3000,
          "inputs": {
            "DO_LOW": true,
            "AERATION_E_STOP_NC": false
          },
          "expected_outputs": {
            "BLOWER_RUN": false,
            "AERATION_BLOWER_CYCLE_COUNT": 0
          },
          "check": "急停保持停止"
        },
        {
          "cycle": 2,
          "inputs": {
            "DO_LOW": true,
            "AERATION_E_STOP_NC": true
          },
          "expected_outputs": {
            "BLOWER_RUN": false
          },
          "check": "恢复后重新完整延时"
        },
        {
          "cycle": 3,
          "advance_ms": 5000,
          "inputs": {
            "DO_LOW": true,
            "AERATION_E_STOP_NC": true
          },
          "expected_outputs": {
            "BLOWER_RUN": true,
            "AERATION_BLOWER_CYCLE_COUNT": 1
          },
          "check": "恢复 5 秒后启动"
        }
      ],
      "coverage": [
        "emergency_stop",
        "delay_reset"
      ],
      "review": {
        "status": "frozen",
        "reviewer": "Codex",
        "notes": []
      }
    }
  ]
}
